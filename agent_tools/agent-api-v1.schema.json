{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YPTalkov/shadow/contracts/agent-api/v1",
  "title": "Shadow agent request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_major",
    "request_id",
    "operation",
    "arguments"
  ],
  "properties": {
    "protocol_major": {
      "type": "integer",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "format": "uuid"
    },
    "operation": {
      "enum": [
        "vault.status",
        "catalog.search",
        "access.request",
        "auth.login",
        "browser.observe",
        "browser.extract",
        "browser.navigate",
        "browser.click",
        "browser.scroll",
        "browser.fill_nonsecret",
        "operation.get",
        "operation.cancel",
        "operation.resume",
        "session.close",
        "connector.request_refresh"
      ]
    },
    "arguments": {
      "type": "object"
    }
  },
  "oneOf": [
    {
      "properties": {
        "operation": {
          "const": "vault.status"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "catalog.search"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "query": {
              "type": "string",
              "maxLength": 256
            },
            "cursor": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "access.request"
        },
        "arguments": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "catalog"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "account_ref",
                "adapter_id",
                "actions"
              ],
              "properties": {
                "kind": {
                  "const": "account_use"
                },
                "account_ref": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "minLength": 64,
                  "maxLength": 64
                },
                "adapter_id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_.-]+$",
                  "minLength": 1,
                  "maxLength": 128
                },
                "actions": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 7,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "login",
                      "observe",
                      "extract",
                      "navigate",
                      "click",
                      "scroll",
                      "fill_nonsecret"
                    ]
                  }
                }
              }
            }
          ]
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "auth.login"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "account_ref",
            "grant_ref",
            "adapter_id"
          ],
          "properties": {
            "account_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "grant_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "adapter_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]+$",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "browser.observe"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_ref",
            "view_id"
          ],
          "properties": {
            "session_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "view_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]+$",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "browser.extract"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_ref",
            "schema_id"
          ],
          "properties": {
            "session_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "schema_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]+$",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "browser.navigate"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_ref",
            "route_id"
          ],
          "properties": {
            "session_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "route_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_.-]+$",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "browser.click"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_ref",
            "element_ref"
          ],
          "properties": {
            "session_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "element_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            }
          }
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "browser.scroll"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_ref",
            "direction"
          ],
          "properties": {
            "session_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "direction": {
              "enum": [
                "up",
                "down"
              ]
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          }
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "browser.fill_nonsecret"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_ref",
            "element_ref",
            "text"
          ],
          "properties": {
            "session_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "element_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "text": {
              "type": "string",
              "maxLength": 2048
            }
          }
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "operation.get"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_ref"
          ],
          "properties": {
            "operation_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            }
          }
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "operation.cancel"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_ref"
          ],
          "properties": {
            "operation_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            }
          }
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "operation.resume"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation_ref",
            "checkpoint_ref"
          ],
          "properties": {
            "operation_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            },
            "checkpoint_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            }
          }
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "session.close"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_ref"
          ],
          "properties": {
            "session_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            }
          }
        }
      }
    },
    {
      "properties": {
        "operation": {
          "const": "connector.request_refresh"
        },
        "arguments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_ref"
          ],
          "properties": {
            "source_ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            }
          }
        }
      }
    }
  ]
}
